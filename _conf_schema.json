{
    "mp_url": {
        "description": "MoviePilot 访问地址",
        "type": "string",
        "default": "",
        "hint": "例如：http://192.168.1.100:3001"
    },
    "mp_apikey": {
        "description": "MoviePilot API Key",
        "type": "string",
        "default": "",
        "hint": "在 MoviePilot 设置 -> 安全 -> API Key 中获取"
    },
    "mp_timeout": {
        "description": "API 请求超时时间（秒）",
        "type": "int",
        "default": 120,
        "hint": "建议 60-300 之间"
    },
    "mp_max_retries": {
        "description": "请求失败时的最大重试次数",
        "type": "int",
        "default": 3,
        "hint": "建议 1-5 之间"
    },
    "mp_retry_delay": {
        "description": "重试间隔时间（秒）",
        "type": "int",
        "default": 1,
        "hint": "每次重试的间隔秒数"
    }
}
